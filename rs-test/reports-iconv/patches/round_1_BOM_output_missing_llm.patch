 pub fn iconv_open(to: &str, from: &str) -> Result<IconvHandle, IconvError> {
     let from_type = find_charmap(from).ok_or(IconvError::InvalidEncoding)?;
     let to_type = find_charmap(to).ok_or(IconvError::InvalidEncoding)?;
